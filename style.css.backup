:root {
    --primary-green: #2E8B57;
    --secondary-green: #8FBC8F;
    --accent-green: #98FB98;
    --light-green: #E8F5E9;
    --dark-text: #2F4F4F;
    --light-text: #FFFFFF;
    --gray-light: #F5F5F5;
    --gray-medium: #CCCCCC;
    --gray-dark: #666666;
    --radius: 12px;
    --transition: 0.3s ease;
    --shadow-sm: 0 2px 8px rgba(0,0,0,0.08);
    --shadow-md: 0 4px 16px rgba(0,0,0,0.12);
    --shadow-lg: 0 8px 32px rgba(0,0,0,0.16);
    --font-sans: 'Poppins', system-ui, sans-serif;
    --font-serif: 'Roboto', serif;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
    font-size: 16px;
}

body {
    font-family: var(--font-sans);
    line-height: 1.7;
    color: var(--dark-text);
    background-color: var(--gray-light);
}

h1, h2, h3 {
    font-weight: 600;
    color: var(--primary-green);
    line-height: 1.3;
}

p {
    margin-bottom: 1rem;
}

a {
    color: var(--primary-green);
    text-decoration: none;
    transition: var(--transition);
}

a:hover {
    color: var(--secondary-green);
}

/* Layout Containers */
.container {
    width: 90%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1rem;
}

section {
    padding: 4rem 0;
}

section:nth-child(even) {
    background-color: var(--light-green);
}

/* Hero Section */
.hero {
    background: linear-gradient(135deg, var(--primary-green), var(--secondary-green));
    color: var(--light-text);
    text-align: center;
    padding: 8rem 2rem;
    position: relative;
    overflow: hidden;
}

.hero::before {
    content: '';
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
    animation: float 6s ease-in-out infinite;
}

@keyframes float {
    0% { transform: translate(0, 0); }
    50% { transform: translate(30px, 30px); }
    100% { transform: translate(0, 0); }
}

.hero-content {
    max-width: 800px;
    margin: 0 auto;
    position: relative;
    z-index: 2;
}

.hero h1 {
    font-size: 2.8rem;
    margin-bottom: 1rem;
    text-shadow: 0 2px 4px rgba(0,0,0,0.2);
}

.hero p {
    font-size: 1.25rem;
    opacity: 0.9;
    max-width: 600px;
    margin: 0 auto 2rem;
}

.btn {
    display: inline-block;
    background: var(--light-text);
    color: var(--primary-green);
    padding: 0.85rem 2rem;
    border-radius: var(--radius);
    font-weight: 500;
    transition: var(--transition);
    border: none;
    cursor: pointer;
    font-size: 1rem;
    box-shadow: var(--shadow-sm);
}

.btn:hover {
    background: #f0f0f0;
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
}

.btn-primary {
    background: var(--primary-green);
    color: var(--light-text);
}

.btn-primary:hover {
    background: var(--secondary-green);
}

.btn-sm {
    padding: 0.5rem 1rem;
    font-size: 0.9rem;
}

/* Navigation */
nav {
    background: var(--light-text);
    box-shadow: var(--shadow-sm);
    position: sticky;
    top: 0;
    z-index: 1000;
}

nav ul {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    list-style: none;
    gap: 1rem;
    padding: 0.75rem 0;
}

nav ul li a {
    padding: 0.5rem 1rem;
    border-radius: var(--radius);
    font-weight: 500;
    transition: var(--transition);
}

nav ul li a:hover,
nav ul li a.active {
    background: var(--light-green);
    color: var(--primary-green);
}

/* Stats Section */
.stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 2rem;
    margin-bottom: 3rem;
    padding: 0 1rem;
}

.stat-card {
    background: var(--light-text);
    border-radius: var(--radius);
    text-align: center;
    padding: 2rem 1.5rem;
    box-shadow: var(--shadow-sm);
    transition: var(--transition);
}

.stat-card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-md);
}

.stat-card h3 {
    font-size: 1.1rem;
    margin-bottom: 0.5rem;
    color: var(--gray-dark);
}

.stat-card p {
    font-size: 1.8rem;
    font-weight: 600;
    color: var(--primary-green);
    margin: 0;
}

/* Cards Layout */
.cards {
    display: grid;
    gap: 2rem;
}

.card {
    background: var(--light-text);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    transition: var(--transition);
    display: flex;
    flex-direction: column;
}

.card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
}

.card-content {
    padding: 1.5rem;
    flex-grow: 1;
}

.card-content h3 {
    margin-top: 0;
    margin-bottom: 1rem;
    font-size: 1.3rem;
}

.card-content p {
    color: var(--gray-dark);
    margin-bottom: 1.5rem;
    flex-grow: 1;
}

.card-content .btn {
    align-self: flex-start;
    font-size: 0.9rem;
}

/* Gallery Section */
.gallery {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
}

.gallery figure {
    margin: 0;
    position: relative;
    overflow: hidden;
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
    transition: var(--transition);
}

.gallery figure:hover {
    transform: scale(1.03);
    box-shadow: var(--shadow-md);
}

.gallery img {
    width: 100%;
    height: 220px;
    object-fit: cover;
    display: block;
    transition: transform var(--transition);
}

.gallery figure:hover img {
    transform: scale(1.05);
}

.gallery figcaption {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: linear-gradient(transparent, rgba(0,0,0,0.7));
    color: var(--light-text);
    padding: 0.75rem 1rem;
    font-size: 0.9rem;
    margin: 0;
}

/* Footer */
footer {
    background: var(--dark-text);
    color: var(--light-text);
}

.footer-content {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 2rem;
    padding: 3rem 0;
}

.footer-section h3 {
    margin-bottom: 1.5rem;
    font-size: 1.2rem;
    position: relative;
    padding-bottom: 0.5rem;
}

.footer-section h3::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 40px;
    height: 3px;
    background: var(--primary-green);
}

.footer-section p {
    margin: 0.5rem 0;
    line-height: 1.6;
    font-size: 0.95rem;
    opacity: 0.9;
}

.footer-section a {
    color: var(--light-text);
    opacity: 0.8;
}

.footer-section a:hover {
    opacity: 1;
    text-decoration: underline;
}

.footer-bottom {
    text-align: center;
    padding: 1.5rem 0;
    border-top: 1px solid rgba(255,255,255,0.1);
    font-size: 0.9rem;
    opacity: 0.8;
}

/* Admin Page Specific Styles */
.admin-container {
    max-width: 900px;
    margin: 2rem auto;
    padding: 2rem;
    background: var(--light-text);
    border-radius: var(--radius);
    box-shadow: var(--shadow-md);
}

.admin-container h2 {
    text-align: center;
    margin-bottom: 2.5rem;
    color: var(--primary-green);
}

.form-group {
    margin-bottom: 1.8rem;
}

.form-group label {
    display: block;
    margin-bottom: 0.5rem;
    font-weight: 500;
    color: var(--gray-dark);
}

.form-group input,
.form-group textarea {
    width: 100%;
    padding: 0.9rem;
    border: 2px solid var(--gray-medium);
    border-radius: var(--radius);
    font-family: inherit;
    font-size: 1rem;
    transition: var(--transition);
    background: var(--light-text);
}

.form-group input:focus,
.form-group textarea:focus {
    outline: none;
    border-color: var(--primary-green);
    box-shadow: 0 0 0 3px rgba(46, 139, 87, 0.2);
}

.form-group textarea {
    min-height: 140px;
    resize: vertical;
}

.btn-full {
    width: 100%;
    padding: 1rem;
    font-size: 1.1rem;
    font-weight: 600;
}

/* Responsive Breakpoints */
@media (max-width: 768px) {
    .hero h1 {
        font-size: 2.2rem;
    }

    .hero p {
        font-size: 1.1rem;
    }

    section {
        padding: 3rem 0;
    }

    .stats {
        grid-template-columns: 1fr;
    }

    .footer-content {
        grid-template-columns: 1fr;
        text-align: center;
    }

    .footer-section h3::after {
        left: 50%;
        transform: translateX(-50%);
    }
}

@media (max-width: 480px) {
    .hero {
        padding: 6rem 1rem;
    }

    .hero h1 {
        font-size: 1.8rem;
    }

    nav ul {
        flex-direction: column;
        align-items: stretch;
    }

    nav ul li a {
        width: 100%;
        text-align: center;
        padding: 1rem;
    }
}