<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ayuntamiento de Resconorio</title>
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&family=Roboto:wght@400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <!-- Hero Section -->
    <section class="hero">
        <div class="hero-content">
            <h1>Ayuntamiento de Resconorio</h1>
            <p>Pueblo montañés en el corazón de la naturaleza</p>
            <a href="#noticias" class="btn btn-primary">Últimos Avisos</a>
        </div>
    </section>

    <nav>
        <ul>
            <li><a href="index.html">Inicio</a></li>
            <li><a href="#noticias">Bandos y Avisos</a></li>
            <li><a href="#calendario">Calendario de Fiestas</a></li>
            <li><a href="#galeria">Galería</a></li>
            <li><a href="admin.html">Acceso de Administración</a></li>
        </ul>
    </nav>
    <main>
        <!-- Quick Stats / Alerts -->
        <section class="stats">
            <div class="stat-card">
                <h3>Población</h3>
                <p>1,245 habitantes</p>
            </div>
            <div class="stat-card">
                <h3>Altitud</h3>
                <p>850 m.s.n.m.</p>
            </div>
            <div class="stat-card">
                <h3>Fiestas Patronales</h3>
                <p>San Juan - 24 junio</p>
            </div>
        </section>

        <section id="noticias">
            <h2>Bandos y Avisos Municipales</h2>
            <div class="avisos cards">
                <!-- Ejemplo de aviso -->
                <div class="aviso card">
                    <h3>Edición especial del Boletín Municipal</h3>
                    <p>Publicado el 19 de mayo de 2026</p>
                    <p>Consulte las últimas novedades del pueblo en nuestro boletín.</p>
                    <a href="#" class="btn btn-sm">Leer más</a>
                </div>
                <!-- Más avisos se pueden añadir aquí -->
            </div>
        </section>

        <section id="calendario">
            <h2>Calendario de Fiestas y Eventos</h2>
            <div class="calendar cards">
                <!-- Este contenido podría ser generado dinámicamente mediante admin o un script simple -->
                <div class="event card">
                    <h3>Fiestas de San Juan</h3>
                    <p><strong>Fecha:</strong> 23-24 de junio de 2026</p>
                    <p>Celebramos nuestras tradicionales fiestas con verbenas, comidas populares y actividades para todos.</p>
                    <a href="#" class="btn btn-sm">Ver detalles</a>
                </div>
                <div class="event card">
                    <h3>Mercado Medieval</h3>
                    <p><strong>Fecha:</strong> 15 de julio de 2026</p>
                    <p>Recorrido por puestos artesanales, gastronomía y espectáculos en la plaza mayor.</p>
                    <a href="#" class="btn btn-sm">Ver detalles</a>
                </div>
            </div>
        </section>

        <section id="galeria">
            <h2>Galería de Fotos</h2>
            <div class="gallery">
                <!-- Images from Unsplash (temporary - replace with actual photos) -->
                <figure>
                    <img src="https://source.unsplash.com/random/400x300/?mountain,village"
                         onerror="this.onerror=null; this.src='https://via.placeholder.com/400x300/2E8B57/FFFFFF?text=Paisaje+Monta%C3%B1eso'; this.alt='Paisaje montañoso de Resconorio';"
                         alt="Paisaje montañoso de Resconorio">
                    <figcaption>Paisaje típico de Resconorio</figcaption>
                </figure>
                <figure>
                    <img src="https://source.unsplash.com/random/400x300/?festival,celebration"
                         onerror="this.onerror=null; this.src='https://via.placeholder.com/400x300/2E8B57/FFFFFF?text=Fiestas+Locales'; this.alt='Fiestas locales';"
                         alt="Fiestas locales">
                    <figcaption>Fiestas del pueblo</figcaption>
                </figure>
                <figure>
                    <img src="https://source.unsplash.com/random/400x300/?heraldry,shield"
                         onerror="this.onerror=null; this.src='https://via.placeholder.com/400x300/2E8B57/FFFFFF?text=Escudo+Del+Pueblo'; this.alt='Escudo de Resconorio';"
                         alt="Escudo de Resconorio">
                    <figcaption>Escudo municipal</figcaption>
                </figure>
                <figure>
                    <img src="https://source.unsplash.com/random/400x300/?river,nature"
                         onerror="this.onerror=null; this.src='https://via.placeholder.com/400x300/2E8B57/FFFFFF?text=R%C3%ADo+y+Naturaleza'; this.alt='Entorno natural';"
                         alt="Entorno natural">
                    <figcaption>Ríos y valles cercanos</figcaption>
                </figure>
                <figure>
                    <img src="https://source.unsplash.com/random/400x300/?architecture,rustic"
                         onerror="this.onerror=null; this.src='https://via.placeholder.com/400x300/2E8B57/FFFFFF?text=Arquitectura+Tradicional'; this.alt='Arquitectura tradicional';"
                         alt="Arquitectura tradicional">
                    <figcaption>Calles y edificios históricos</figcaption>
                </figure>
                <figure>
                    <img src="https://source.unsplash.com/random/400x300/?food,local"
                         onerror="this.onerror=null; this.src='https://via.placeholder.com/400x300/2E8B57/FFFFFF?text=Gastronom%C3%ADa+Local'; this.alt='Gastronomía local';"
                         alt="Gastronomía local">
                    <figcaption>Platos típicos de la región</figcaption>
                </figure>
            </div>
        </section>
    </main>
    <footer>
        <div class="footer-content">
            <div class="footer-section">
                <h3>Ayuntamiento de Resconorio</h3>
                <p>Pueblo montañés con encanto</p>
            </div>
            <div class="footer-section">
                <h3>Contacto</h3>
                <p>📞 987 654 321</p>
                <p>✉️ info@ayuntamientoresconorio.es</p>
                <p>📍 Plaza Mayor, 1</p>
            </div>
            <div class="footer-section">
                <h3>Horarios</h3>
                <p>Lunes-Viernes: 9:00-14:00 y 16:00-20:00</p>
                <p>Sábados: 10:00-13:00</p>
            </div>
        </div>
        <div class="footer-bottom">
            <p>&copy; 2026 Ayuntamiento de Resconorio. Todos los derechos reservados.</p>
        </div>
    </footer>
</body>
</html>